---
// Starlight's page content, plus a full-screen view of any screenshot: on a
// phone a screenshot shows at a fraction of its size, too small to read.
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
---

<Default><slot /></Default>
<dialog class="zoom" aria-label="Full-size image">
  <form method="dialog"><button>Close</button></form>
  <img alt="" />
</dialog>

<script>
  // Screenshots are captured at deviceScaleFactor 2
  // (tests/docs-screenshots.config.ts), so half their pixel width is the size
  // they were taken at.
  const CAPTURE_SCALE = 2;
  const dialog = document.querySelector<HTMLDialogElement>("dialog.zoom")!;
  const full = dialog.querySelector("img")!;

  document.addEventListener("click", (event) => {
    const image = (event.target as Element).closest(".sl-markdown-content img");
    if (!(image instanceof HTMLImageElement) || image.closest("a")) return;
    full.src = image.currentSrc;
    full.alt = image.alt;
    full.style.width = `${image.naturalWidth / CAPTURE_SCALE}px`;
    dialog.showModal();
  });
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  :global(.sl-markdown-content img:not(a img)) {
    cursor: zoom-in;
  }
  dialog {
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 0 env(safe-area-inset-bottom, 0px);
    border: 0;
    overflow: auto;
    background: var(--sl-color-black);
  }
  dialog::backdrop {
    background: var(--sl-color-black);
  }
  form {
    position: sticky;
    top: 0;
    left: 0;
    display: flex;
    justify-content: end;
    padding: max(0.75rem, env(safe-area-inset-top, 0px))
      max(0.75rem, env(safe-area-inset-right, 0px)) 0.75rem;
  }
  button {
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font: inherit;
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
    cursor: pointer;
  }
  button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  dialog img {
    display: block;
    max-width: none;
    height: auto;
    margin: 0 auto;
    padding-inline: 0.75rem;
    box-sizing: content-box;
  }
</style>
